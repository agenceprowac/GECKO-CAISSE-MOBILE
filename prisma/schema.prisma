// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String    @id @default(uuid())
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  users       User[]
  categories  Category[]
  products    Product[]
  tables      Table[]
  orders      Order[]
}

enum Role {
  ADMIN
  BARMAN
  WAITER
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  pinCode   String   @db.VarChar(4) // PIN 4 chiffres pour switch rapide
  role      Role     @default(WAITER)
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  orders    Order[]
}

model Category {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  color     String?   // Couleur pour l'UI (ex: '#FF5733')
  icon      String?   // Nom de l'icône
  
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  products  Product[]
}

model Product {
  id          String    @id @default(uuid())
  tenantId    String
  categoryId  String
  name        String
  price       Float
  stock       Int       @default(0) // Gestion de stock simple
  isAvailable Boolean   @default(true)
  
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  category    Category  @relation(fields: [categoryId], references: [id])
  inventory   Inventory[]
  orderItems  OrderItem[]
}

model Table {
  id        String   @id @default(uuid())
  tenantId  String
  name      String   // Ex: "Table 1" ou "Ardoise M. Paul"
  isActive  Boolean  @default(true)
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  orders    Order[]
}

enum OrderStatus {
  OPEN
  PAID
  CANCELLED
}

model Order {
  id          String      @id @default(uuid())
  tenantId    String
  tableId     String?
  userId      String
  status      OrderStatus @default(OPEN)
  totalAmount Float       @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  table       Table?      @relation(fields: [tableId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]
  payments    Payment[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Float
  
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY // Wave, Orange Money, MTN MoMo
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  amount        Float
  method        PaymentMethod
  createdAt     DateTime      @default(now())
  
  order         Order         @relation(fields: [orderId], references: [id])
}

model Inventory {
  id          String    @id @default(uuid())
  productId   String
  quantity    Int       // Changement de quantité (+ ou -)
  reason      String    // Ex: "VENTE", "PERTE", "OFFRE"
  createdAt   DateTime  @default(now())
  
  product     Product   @relation(fields: [productId], references: [id])
}
